{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Invoy",
  "version": "2.0.0",
  "identifier": "com.invoy.dz",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run react-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Invoy",
        "width": 1380,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "backgroundColor": "#f5f7fb",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
